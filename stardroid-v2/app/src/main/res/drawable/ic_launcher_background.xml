<!--
  SkyLuz launcher icon — background layer.
  Original artwork for the SkyLuz fork (GPLv3 project). Deep-night radial
  nebula with a faint scattered starfield. Vector adaptive layer, 108dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="42"
                android:centerY="34"
                android:gradientRadius="96">
                <item android:offset="0.0" android:color="#FF101C42" />
                <item android:offset="0.55" android:color="#FF0A1130" />
                <item android:offset="1.0" android:color="#FF1A1250" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- soft violet nebula wash, lower right -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="84"
                android:centerY="88"
                android:gradientRadius="64">
                <item android:offset="0.0" android:color="#337A5BD6" />
                <item android:offset="1.0" android:color="#007A5BD6" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- faint diagonal milky-way band -->
    <path
        android:pathData="M-10,78 Q 40,58 70,30 T 130,10 L130,-10 L-10,-10 Z"
        android:fillColor="#08AFC4E8" />
    <!-- scattered background stars -->
    <path android:pathData="M18,22h0.9v0.9h-0.9z M30,58h0.7v0.7h-0.7z M88,28h0.9v0.9h-0.9z M74,16h0.7v0.7h-0.7z M92,64h0.8v0.8h-0.8z M24,84h0.7v0.7h-0.7z M46,92h0.9v0.9h-0.9z M64,26h0.6v0.6h-0.6z"
        android:fillColor="#B8CDE8" />
</vector>