<!--
  SkyLuz launcher icon — foreground layer.
  Original artwork for the SkyLuz fork (GPLv3 project). Vega (alpha Lyrae)
  as a glowing 8-point star with diffraction spikes, the Lyra parallelogram
  as delicate star-dots and connecting lines. Content sits inside the
  adaptive-icon safe zone (66dp circle of the 108dp canvas).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Lyra constellation lines (behind the stars) -->
    <path
        android:pathData="M38.5,38.5 L47.5,63.5 L60.5,64.5 L66.5,54 L56.5,44.5 Z M47.5,63.5 L54.5,77.5 L60.5,64.5"
        android:strokeColor="#669BD3FF"
        android:strokeWidth="1.4"
        android:fillColor="#00000000"
        android:strokeLineCap="round" />
    <!-- Lyra stars: Sheliak, Sulafat, delta, zeta (parallelogram) -->
    <path
        android:pathData="M47.5,63.5h1.8v1.8h-1.8z M60.5,64.5h1.8v1.8h-1.8z M66.5,54h1.6v1.6h-1.6z M56.5,44.5h1.6v1.6h-1.6z"
        android:fillColor="#CFE4FF" />
    <!-- Vega: soft glow -->
    <path
        android:pathData="M38.5,38.5m-9,0a9,9 0 1,1 18,0a9,9 0 1,1 -18,0"
        android:fillColor="#2E8FD0FF" />
    <path
        android:pathData="M38.5,38.5m-5,0a5,5 0 1,1 10,0a5,5 0 1,1 -10,0"
        android:fillColor="#55B8DCFF" />
    <!-- Vega: 8-point star core -->
    <path
        android:pathData="M38.5,31.5 L39.9,36.1 L44.5,34.7 L41.3,38.5 L44.5,42.3 L39.9,40.9 L38.5,45.5 L37.1,40.9 L32.5,42.3 L35.7,38.5 L32.5,34.7 L37.1,36.1 Z"
        android:fillColor="#FFFFFF" />
    <!-- Vega: diffraction spikes -->
    <path
        android:pathData="M38.5,27 L38.5,31 M38.5,46 L38.5,50 M34,38.5 L31,38.5 M46,38.5 L50,38.5"
        android:strokeColor="#F0F7FF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />
</vector>